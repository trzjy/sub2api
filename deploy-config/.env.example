# Sub2API environment template
# Copy to .env on server:  cp .env.example .env
# Fill real secrets from existing server /opt/sub2api/.env

# Network / server
BIND_HOST=127.0.0.1
SERVER_PORT=3300
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# 网页登录代理隔离 origin（独立端口，与主服务 origin 隔离，防官方页脚本读取管理端 localStorage）。
# 留空 WEB_LOGIN_PROXY_ADDR 则禁用隔离 engine（前端 iframe 回退同源）。
WEB_LOGIN_PROXY_ADDR=:3400
# 隔离 origin 映射到宿主机的端口（与上方 compose ports 对应）。
WEB_LOGIN_PROXY_PORT=3400
# 可选：隔离 origin 对外的公开地址（前端 iframe 契约）。容器经端口映射对外暴露在不同 host 时设置，
# 例如 http://your-host:3400；留空则由 WEB_LOGIN_PROXY_ADDR 推导（通配 host 时回退同源）。
WEB_LOGIN_PROXY_ORIGIN=
# 隔离 origin 对外绑定地址（仅监听特定接口时设置，默认 127.0.0.1）。
WEB_LOGIN_PROXY_BIND=127.0.0.1

# PostgreSQL
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sub2api

# Redis (empty = no password, internal network)
REDIS_PASSWORD=

# Admin account (used by AUTO_SETUP on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# MUST stay fixed across restarts (else sessions/2FA break)
JWT_SECRET=CHANGE_ME
TOTP_ENCRYPTION_KEY=CHANGE_ME

# 账号凭证静态加密（AES-256-GCM）。留空 = 明文存储（向后兼容，启动有警告）。
# 生成：openssl rand -base64 32
# 轮换：新密钥放 CRED_ENCRYPTION_KEY，旧密钥放 CRED_ENCRYPTION_KEY_OLD（仅解密用），
# 完成存量重加密后移除 CRED_ENCRYPTION_KEY_OLD。
CRED_ENCRYPTION_KEY=
CRED_ENCRYPTION_KEY_OLD=

# Xianyu Worker (内网自动发货 Worker)
# XIANYU_INTERNAL_TOKEN 必须与主程序 xianyu_delivery.internal_token 同值（双向认证）。
XIANYU_INTERNAL_TOKEN=CHANGE_ME
XIANYU_SYSTEM_USER_ID=1
# 必填：构建后的 Worker 镜像 tag（禁止 latest/reviewed 漂浮标签）。
# 镜像在部署主机直接构建（本机构建无 registry RepoDigest，@sha256 digest 引用无法解析，故用固定 tag），
# 部署后通过 docker inspect 校验运行容器镜像 ID 与构建产物一致（旧 sha256:8343c385...46d5 不含 launcher/internal 路由/回传，已废弃；
# 中间版 prod-fix34-20260830-172747 / sha256:d1fd4b249713...cb518 已由 EnsureDeliveryRecord 适配层提交替代）。
# 当前生产值：prod-fix34-ensure-20260830-203928（构建镜像 ID sha256:10e96f9f54638945e131b04e1b969d33865b3de0b8e1f72f1863f3941fa3d640）
XIANYU_WORKER_IMAGE_TAG=prod-fix34-ensure-20260830-203928
XIANYU_WORKER_MYSQL_USER=xianyu
XIANYU_WORKER_MYSQL_PASSWORD=CHANGE_ME
XIANYU_WORKER_MYSQL_ROOT_PASSWORD=CHANGE_ME
XIANYU_WORKER_MYSQL_DB=xianyu
# 可选：定时商品同步的全量轮间隔（秒），低频完整翻页触发下架商品清理；0/负数=禁用。缺省 86400。
XIANYU_WORKER_FULL_SYNC_INTERVAL_SECONDS=86400
